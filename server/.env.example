# Copy to server/.env for local dev (npm run dev / npm run migrate). Set the same values in Vercel → Settings → Environment Variables.

# Neon → your project → Connect → "Pooled connection" string (host contains -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this API once deployed, e.g. https://crew-tasks-api.vercel.app (http://localhost:3000 for local dev)
BETTER_AUTH_URL=http://localhost:3000

# Optional: protects the daily cron endpoint (Vercel sends it automatically). openssl rand -hex 24
CRON_SECRET=

# Optional: photo attachments (Vercel → Storage → Blob → connect to project; it adds this for you)
BLOB_READ_WRITE_TOKEN=

# Optional: password-reset codes by email via Resend (verify a sending domain first)
RESEND_API_KEY=
EMAIL_FROM=Crew Tasks <noreply@yourdomain.com>

# Optional: only if you enabled "Enhanced push security" on expo.dev
EXPO_ACCESS_TOKEN=
