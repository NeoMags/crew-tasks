# Copy to .env (git-ignored) for local development of the app.

# Public URL of the Crew Tasks API (your Vercel deployment of server/), no trailing slash.
# For local dev against `npm run server:dev`, use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://crew-tasks-api.vercel.app

# Optional: hide photo attachments if the server has no Blob store configured.
# EXPO_PUBLIC_ATTACHMENTS=off

# Optional (push notifications): EAS project id from expo.dev, plus google-services.json in the repo root.
# EAS_PROJECT_ID=

# Optional: Android application id.
# ANDROID_PACKAGE=com.neomags.crewtasks
