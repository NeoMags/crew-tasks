# Copy to .env (git-ignored) for local development.
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Android application id (must match the Android app registered in Firebase).
# ANDROID_PACKAGE=com.neomags.crewtasks

# Set to off if your Firebase project is on the free Spark plan (Cloud Storage needs Blaze).
# EXPO_PUBLIC_ATTACHMENTS=off
